    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.0.0",
    "nodemailer": "^10.0.15"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "mongodb-memory-server": "^10.0.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "vitest": "^3.2.7"
  }
}
