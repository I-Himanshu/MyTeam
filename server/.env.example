# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit it.

# HTTP port the API listens on (defaults to 5000 when unset).
PORT=5000

# MongoDB connection string — used by TASK-002 (Mongoose connection).
MONGO_URI=mongodb://localhost:27017/myteam

# JWT signing secret — used by TASK-003. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret

# JWT lifetime, e.g. 1h, 30m, 1d — used by TASK-003.
JWT_EXPIRES_IN=1d

# Frontend origin allowed by CORS. Must match the client dev server.
CLIENT_URL=http://localhost:3000

# Auth rate limiting (TASK-008): max requests per IP per window on
# POST /api/auth/login and POST /api/auth/register. Safe defaults apply
# when unset: 100 requests per 15 minutes (900000 ms).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# SMTP configuration for password reset emails (TASK-017).
# When SMTP_HOST is unset, emails are serialized as JSON (useful for tests).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MyTeam" <no-reply@example.com>
